APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_DATABASE_TELEGRAM_BOT=telegrambot
DB_USERNAME_TELEGRAM_BOT=root
DB_PASSWORD_TELEGRAM_BOT=

# ─── Safe multisig ────────────────────────────────────────────────────────────
# Dirección del Safe multisig desde el que se proponen las transacciones
SAFE_MULTISIG_ADDRESS=
# Dirección del proponente (aparece en la Safe App como creador del batch)
# No necesita ser owner del Safe; los owners aprueban desde la Safe App.
# Clave privada del proponente CIFRADA con el vault: salida de `php artisan encryption:encrypt <clave>`
SAFE_PROPOSER_PRIVATE_KEY=
SAFE_PROPOSER_ADDRESS=
# ─── Opcional: clave de API de Safe.global ────────────────────────────────────
SAFE_API_KEY=
# ─── Red por defecto para el batch de USDT ────────────────────────────────────
# Opciones: bsc | polygon | ethereum | base | arbitrum | optimism
SAFE_DEFAULT_NETWORK=bsc
# ──────────────────────────────────────────────────────────────────────────────

# ─── WalletConnect / Reown AppKit ──────────────────────────────────────────────
# Usadas por dvzambrano/safe para la página /safe/sign/{network}/{safeTxHash}
# (el botón "✍️ Firmar / Ejecutar" del batch). El Project ID es WALLETCONNECT_PROJECT_ID
# (más abajo, en servicios de terceros).
WALLET_NAME=
WALLET_DESCRIPTION=
WALLET_ICON=
WALLETCONNECT_THEME=light
WALLETCONNECT_LANG=es
WALLETCONNECT_EMAIL=false
WALLETCONNECT_SOCIALS=
WALLETCONNECT_CHAINS=56

CHAINID_HTTP_TIMEOUT=240
# ──────────────────────────────────────────────────────────────────────────────

# ─── ZentroTraderBot ──────────────────────────────────────────────────────────
BOT_MAINTENANCE_MODE=false
TRADER_BOT_NAME=
TRADER_BOT_THEME=FlexStart
TRADER_BOT_CHANNEL=
TRADER_BOT_SUPPORT=
# MM5
TRADER_BOT_KEY=
# Permite activar Log::debug para modo DEV
DEBUG_MODE=true
P2P_ENABLED=true
BLOCKCHAIN_PROVIDER=Moralis
RAMP_ENABLED=false
# 80002 (Polygon Amoy TESTNet), 137 (Polygon Mainnet)
BASE_NETWORK=80002
# 0x52ef3d68bab452a294342dc3e5f464d7f610f72e (WETH TESTNet)
# 0x8b0180f2101c8260d49339abfee87927412494b4 (Mock USDC TESTNet)
# 0x41e94eb019c0762f9bfcf9fb1e58725bfb0e7582 (USDC TESTNet)
# 0x8f3cf7ad23cd3cadbd9735aff958023239c6a063 (Dai POL)
# 0x3c499c542cef5e3811e1192ce70d8cc03d5c3359 (USDC POL)
BASE_TOKEN=
DEBRIDGE_REFERRAL_CODE=
ZERO_EX_API_KEY=
# Recepcion de Fees de SWAP (MM5)
TREASURY_WALLET=
# Fee se swap en servicios de terceros (0.01%)
SWAP_FEE_PERCENTAGE=0.01
# Contrato de Escrow Activo
ESCROW_CONTRACT=
# Gas estimado de uso del contrato para procesar una transacción (calculado)
ESCROW_GAS_ESTIMATED=312000
# Fee de ESCROW en operaciones normales (0.25%)
ESCROW_FEE_PERCENTAGE=0.25
# Fee de ESCROW minimo para operaciones DUST (0.01 USD)
ESCROW_MIN_FEE=0.01
# Billetera (MM4) del arbitro encriptada
ESCROW_ARBITER_KEY=
# Servicios de terceros
WALLET_CONNECT_API_KEY=
# Mismo Project ID de Reown/WalletConnect Cloud que WALLET_CONNECT_API_KEY (arriba),
# leido por el paquete dvzambrano/walletconnect bajo este nombre de variable.
WALLETCONNECT_PROJECT_ID=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
ALCHEMY_SIGNING_KEY=
ALCHEMY_AUTH_TOKEN=
MORALIS_API_KEY=
TRONDEALER_API_KEY=
TRONDEALER_WEBHOOK_SECRET=
TRONDEALER_HTTP_TIMEOUT=15
TRONDEALER_MAX_RETRIES=3
# ──────────────────────────────────────────────────────────────────────────────

# ─── GutoTradeBot ─────────────────────────────────────────────────────────────
TELEGRAM_GROUP_GUTO_TRADE_BOT=

# Protege el panel admin web de dvzambrano/telegrambot (bot-create, bot-webhook,
# bot-set-webhook, bot-reset-webhooks, bot-leaked, bot-purge-blocked-actors,
# bot-stop-job), sin esto quedan abiertas sin autenticación.
TELEGRAM_ADMIN_MIDDLEWARE=auth,verified,2fa
GOOGLE_VISION_API_KEY=
ANTHROPIC_API_KEY=
OCR_DRIVER=google_vision
OCR_HTTP_TIMEOUT=60
# ──────────────────────────────────────────────────────────────────────────────

# Solo LECTURA del buzón (webklex/laravel-imap, job CheckEmails). El envío de correo usa MAIL_*.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default
IMAP_TIMEOUT=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Destino del backup diario de gutotradebot (se envía con el mailer MAIL_* de arriba)
GUTOTRADEBOT_BACKUP_EMAIL_TO=

